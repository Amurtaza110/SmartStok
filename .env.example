# SmartStock Environment Variables
SECRET_KEY=replace-with-a-random-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_TOKEN=replace-with-a-random-service-token
AI_DATABASE_PATH=ai_service/data.sqlite3
INVENTORY_SERVICE_URL=http://127.0.0.1:8000
INVENTORY_SERVICE_TOKEN=replace-with-another-random-service-token

# PostgreSQL
DB_NAME=smartstock
DB_USER=postgres
DB_PASSWORD=replace-with-a-strong-password
DB_HOST=localhost
DB_PORT=5432

# Ollama (AI Chatbot)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=60
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
